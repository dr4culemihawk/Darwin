# Copy to .env and fill in. NEVER commit .env.

# --- Claude (strategy generation + evolution) ---
ANTHROPIC_API_KEY=
# Optional: custom Anthropic-compatible endpoint (e.g. DGRID gateway). Leave blank for Anthropic direct.
ANTHROPIC_BASE_URL=
# Runtime model (default: Claude Opus 5.5). For a cheaper, faster evolution run
# use claude-sonnet-5-5. Through a gateway, use that gateway's own model name.
DARWIN_MODEL=claude-opus-5-5

# --- CoinMarketCap (market data + signals) ---
CMC_PRO_API_KEY=

# --- BNB Chain (TWAK execution + on-chain agent identity) ---
BSC_PRIVATE_KEY=
BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_CHAIN_ID=97
# Password to encrypt the local BNB Agent SDK keystore (testnet throwaway is fine).
WALLET_PASSWORD=darwin-testnet

# --- Trust Wallet Agent Kit portal API (portal.trustwallet.com) ---
TWAK_ACCESS_ID=
TWAK_HMAC_SECRET=
